{
  "name": "ci360-realtime-job-board",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build -w client && npm run build -w server",
