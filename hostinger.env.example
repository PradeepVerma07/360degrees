NODE_ENV=production
# Hostinger provides PORT automatically. Do not hard-code PORT unless hPanel requires it.
CLIENT_ORIGIN=https://your-domain.com
JWT_SECRET=replace-with-at-least-32-random-characters

# Hostinger MySQL is normally reached through localhost from the hosted Node.js app.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_ci360
DB_USER=u123456789_ci360user
DB_PASSWORD=replace-with-your-mysql-password
DB_CONNECTION_LIMIT=10
SEED_DEMO_DATA=false
